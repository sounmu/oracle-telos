# OpenAI API 키 (AI 특허 분석 기능에 필요). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 에이전트 모델 (기본 gpt-5.5). 키에 권한이 없으면 gpt-5.4-mini 등으로 변경
# OPENAI_MODEL=gpt-5.5
# 추론 강도 (none | minimal | low | medium | high). 기본 low — 데모 속도 우선
# OPENAI_REASONING_EFFORT=low

# 데이터 파이프라인이 추출할 특허 건수 (기본 3000)
# PATENT_COUNT=3000

# 한국 특허 (KIPRIS Plus에서 상품 신청 후 발급한 키)
KIPRIS_API_KEY=

# 국가법령정보 공동활용에서 승인받은 API 인증값(OC)
LAW_OC=

# Open DART 인증키. 법령/공시는 선택적 참고자료 기능에만 사용
DART_API_KEY=

# 한국 데이터 비공개 저장 위치. 기본 data/korea (Git 제외)
# 외부 경로를 지정하는 경우 그 경로도 별도로 접근 제어할 것
# TELOS_RESEARCH_DIR=/absolute/private/path/telos-korea
